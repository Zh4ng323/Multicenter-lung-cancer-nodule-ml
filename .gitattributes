* text=auto

# Normalize source files to LF for consistent diffs across platforms.
*.py  text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.sh  text eol=lf
Makefile text eol=lf

# Binary artifacts — never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.npy binary
*.joblib binary
